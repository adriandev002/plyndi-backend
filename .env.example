# Copy this file to .env for local development:  cp .env.example .env
# On Render, set these as real Environment Variables in the dashboard instead — .env is never
# deployed (see .gitignore) and render.yaml deliberately leaves these blank (sync: false) so
# Render prompts for them rather than trying to read a value that doesn't exist anywhere.

# At least one of these two is required for the /v1/gemini and /v1/openai routes to work.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Required for the /v1/places routes.
GOOGLE_PLACES_API_KEY=

# Required — a random shared secret, NOT a per-user password. Generate one with:
#   openssl rand -hex 32
# The same value goes into both the iOS and (later) Android app builds — see README.md's
# "Wiring up the apps" section. Every request without a matching X-Plyndi-Client-Key header is
# rejected before it reaches any route or spends any AI/Places quota.
CLIENT_SHARED_KEY=

# Optional — defaults shown.
PORT=3000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MINUTES=60

# GET /v1/config (Phase 0 kill switch / version gate) needs no env vars — its payload is
# src/config/remote-config.json. Edit that file on the host and reload it into the running
# process with `kill -HUP <pid>` (no restart, no redeploy). It has its own generous rate limit
# and is exempt from RATE_LIMIT_MAX above, so a flipped kill switch can never be throttled away.

# POST /v1/ai/run (Phase 1-A capability registry) also needs no env vars of its own — each
# capability's prompt/schema/token-budget lives in capabilities/*.json, reloaded the same way as
# remote-config.json (`kill -HUP <pid>`, no restart). Optional overrides:
AI_CONTEXT_MAX_BYTES=20000
AI_RUN_STORE_MAX=500
AI_RUN_STORE_TTL_MS=86400000

# Sync backup controls. Use a durable encrypted volume/object store in deployment; the local
# filesystem is suitable only for development or a host with persistent storage.
SYNC_STORAGE_DIR=storage/backups
SYNC_MAX_VERSIONS=10
SYNC_MAX_SCHEMA_VERSION=1
# Secure sync mode is the default. Configure the server-only HS256 signing secret and send
# Authorization: Bearer <JWT with sub and exp>. Set SYNC_REQUIRE_VERIFIED_IDENTITY=false only
# for local development; X-Plyndi-User-ID is then client-supplied and can be spoofed.
SYNC_JWT_SECRET=
SYNC_REQUIRE_VERIFIED_IDENTITY=true

# AI credits + global spend cap (Phase 3-A, Plyndi-AI-Hub-Design.md §4.5/§4.6/§6/§7).
# None of these are required for the server to boot — every one has a sane default and the server
# falls back to the in-memory store when DATABASE_URL is unset (loudly logged; runs/credits are
# then NOT durable and reset on every restart). See README.md's "AI credits & spend cap" section
# for what to actually do on Render before turning any of this on for real.
#
# Render Postgres connection string. Unset -> the in-memory store (src/lib/store/memoryStore.js);
# set -> the Postgres store (src/lib/store/postgresStore.js). Run `npm run migrate` once after
# setting this (idempotent, safe to re-run on every deploy).
DATABASE_URL=
# Set only for a local, non-TLS Postgres in development. Leave unset for Render, which needs TLS.
PGSSLMODE=
# Server-only HS256 signing secret for a FUTURE verified-account bearer token on /v1/ai/run — there
# is no real account system yet (see src/lib/subject.js's header comment), so leave this unset
# today; nothing currently issues a token that would verify against it.
AI_JWT_SECRET=
# Lenient (false) by default, unlike SYNC_REQUIRE_VERIFIED_IDENTITY's strict default — shipped
# builds send NO identity header today, and breaking that request breaks every installed copy of
# the app with no fix but an App Store release. Do not flip this until a real account system with
# server-verifiable tokens exists.
AI_REQUIRE_VERIFIED_IDENTITY=false
# Monthly credit allowance applied uniformly to every subject (device-scoped — there is no
# server-verifiable Premium signal to grant a bigger Premium allowance yet). Plyndi-AI-Hub-Design.md
# §6's first guess for the FREE tier; expect to retune after real usage data comes in.
AI_MONTHLY_CREDIT_ALLOWANCE=15
# SHADOW MODE by default: an over-allowance subject is logged and still served, never refused.
# Flip to true only after AI_MONTHLY_CREDIT_ALLOWANCE has been validated against real traffic.
AI_CREDITS_ENFORCE=false
# The ONE limit that enforces unconditionally from day one, no flag — total credits (summed across
# EVERY subject) allowed per UTC calendar day before POST /v1/ai/run returns 429 to everyone. This
# is what actually bounds the damage from a leaked CLIENT_SHARED_KEY; retune once real per-day
# usage is known.
AI_DAILY_CREDIT_CAP=2000
# In-memory credit-ledger tuning (used only when DATABASE_URL is unset) — AI_RUN_STORE_MAX/
# AI_RUN_STORE_TTL_MS above already cover run storage; these are new for the ledger half.
AI_CREDIT_LEDGER_MAX=20000
AI_CREDIT_LEDGER_TTL_MS=3024000000

# Daily Brief (Phase 4-A, Plyndi-AI-Hub-Design.md §3.1). No env vars of its own are required —
# its prompt/schema/token budget/creditCost live in capabilities/daily_brief.json (reloaded the
# same way as every other capability, `kill -HUP <pid>`), and generation reuses
# AI_CONTEXT_MAX_BYTES and AI_DAILY_CREDIT_CAP above (the brief is free for every user but still
# counts toward the same global daily spend cap — see src/routes/aiBrief.js's header comment).
# In-memory brief-cache tuning (used only when DATABASE_URL is unset) — same shape as
# AI_RUN_STORE_MAX/AI_RUN_STORE_TTL_MS above, for the (subject, localDate) brief cache instead.
AI_BRIEF_STORE_MAX=5000
AI_BRIEF_STORE_TTL_MS=7776000000

# Ask Plyndi intent router (Phase 5-A, Plyndi-AI-Hub-Design.md §3.2). No env vars of its own —
# it's a normal capability (capabilities/ask_router.json, reloaded the same way as any other,
# `kill -HUP <pid>`) run through the existing POST /v1/ai/run, so it reuses AI_CONTEXT_MAX_BYTES,
# AI_DAILY_CREDIT_CAP, AI_CREDITS_ENFORCE, and AI_MONTHLY_CREDIT_ALLOWANCE above like any other
# capability. Its client-facing kill switch is remote-config.json's features.ask_router.

# Affiliate recommendations. Without a marker, direct provider links are used.
# TRAVELPAYOUTS_MARKER is the Travelpayouts API Marker ID used by the tp.media redirect.
# TRAVELPAYOUTS_API_KEY is server-only and is required for optional live Flight Data API adapters.
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_API_KEY=
TRAVELPAYOUTS_FLIGHT_DATA_API_URL=
# Optional Travelpayouts/Impact-compatible URL template with {url}, {provider}, {subId},
# {origin}, {destination}, and {dates} placeholders for custom tracked deep links.
TRAVELPAYOUTS_DEEPLINK_WRAPPER=
IMPACT_DEEPLINK_WRAPPER=
TRIPCOM_AFFILIATE_WRAPPER=
AGODA_AFFILIATE_WRAPPER=
BOOKING_AFFILIATE_WRAPPER=
EXPEDIA_AFFILIATE_WRAPPER=
SKYSCANNER_AFFILIATE_WRAPPER=
PRICELINE_AFFILIATE_WRAPPER=
WEBJET_AFFILIATE_WRAPPER=
# Optional region controls. Trusted edge country headers take precedence.
DEFAULT_REGION=US
# Comma-separated entries such as 203.0.113.:EU,198.51.100.:ASIA
GEOIP_REGION_MAP=

# Which model serves each profile, in preference order: "provider:model,provider:model".
# Measured Sep 2026 on a real one-day Osaka itinerary request:
#   gpt-4o-mini (strict schema) ~6.7s   |   gemini-3.6-flash ~18s, and 30s+ on a bad run.
# Pin STABLE model ids — never a "-latest" alias, which Google hot-swaps without notice.
MODELS_RICH=openai:gpt-4o-mini,gemini:gemini-3.6-flash
MODELS_FAST=openai:gpt-4o-mini,gemini:gemini-3.6-flash
PROVIDER_TIMEOUT_MS=30000
REQUEST_DEADLINE_MS=45000
