# Copy this file to .env for local development:  cp .env.example .env
# On Render, set these as real Environment Variables in the dashboard instead — .env is never
# deployed (see .gitignore) and render.yaml deliberately leaves these blank (sync: false) so
# Render prompts for them rather than trying to read a value that doesn't exist anywhere.

# At least one of these two is required for the /v1/gemini and /v1/openai routes to work.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Required for the /v1/places routes.
GOOGLE_PLACES_API_KEY=

# Required — a random shared secret, NOT a per-user password. Generate one with:
#   openssl rand -hex 32
# The same value goes into both the iOS and (later) Android app builds — see README.md's
# "Wiring up the apps" section. Every request without a matching X-Plyndi-Client-Key header is
# rejected before it reaches any route or spends any AI/Places quota.
CLIENT_SHARED_KEY=

# Optional — defaults shown.
PORT=3000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MINUTES=60

# Sync backup controls. Use a durable encrypted volume/object store in deployment; the local
# filesystem is suitable only for development or a host with persistent storage.
SYNC_STORAGE_DIR=storage/backups
SYNC_MAX_VERSIONS=10
SYNC_MAX_SCHEMA_VERSION=1
# Secure sync mode is the default. Configure the server-only HS256 signing secret and send
# Authorization: Bearer <JWT with sub and exp>. Set SYNC_REQUIRE_VERIFIED_IDENTITY=false only
# for local development; X-Plyndi-User-ID is then client-supplied and can be spoofed.
SYNC_JWT_SECRET=
SYNC_REQUIRE_VERIFIED_IDENTITY=true

# Affiliate recommendations. Without a marker, direct provider links are used.
# TRAVELPAYOUTS_MARKER is the Travelpayouts API Marker ID used by the tp.media redirect.
# TRAVELPAYOUTS_API_KEY is server-only and is required for optional live Flight Data API adapters.
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_API_KEY=
TRAVELPAYOUTS_FLIGHT_DATA_API_URL=
# Optional Travelpayouts/Impact-compatible URL template with {url}, {provider}, {subId},
# {origin}, {destination}, and {dates} placeholders for custom tracked deep links.
TRAVELPAYOUTS_DEEPLINK_WRAPPER=
IMPACT_DEEPLINK_WRAPPER=
TRIPCOM_AFFILIATE_WRAPPER=
AGODA_AFFILIATE_WRAPPER=
BOOKING_AFFILIATE_WRAPPER=
EXPEDIA_AFFILIATE_WRAPPER=
SKYSCANNER_AFFILIATE_WRAPPER=
PRICELINE_AFFILIATE_WRAPPER=
WEBJET_AFFILIATE_WRAPPER=
# Optional region controls. Trusted edge country headers take precedence.
DEFAULT_REGION=US
# Comma-separated entries such as 203.0.113.:EU,198.51.100.:ASIA
GEOIP_REGION_MAP=
